# Incancelables E-Commerce — variables de entorno
# Copiar este archivo como .env e ingresar los valores del entorno.
# .env está ignorado por Git: jamás se versiona.
# Este archivo SÍ se versiona y nunca debe contener credenciales reales.

# --- Conexión MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=incancelables_ecommerce
DB_USER=root
DB_PASSWORD=

# --- Canal de email (log | resend) ---
EMAIL_CHANNEL=log

# --- API de Resend ---
RESEND_API_KEY=
RESEND_FROM=no-reply@ejemplo.test
